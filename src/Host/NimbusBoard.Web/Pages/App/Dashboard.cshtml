@page "/app/dashboard"
@model Nimbus_Board.Pages.App.DashboardModel
@using Nimbus_Board.Models
@{
    ViewData["Title"] = Model.Copy.PageTitle;
    var content = new DashboardContentModel
    {
        Data = Model.ViewModel,
        Copy = Model.Copy
    };
}

<partial name="/Views/Partials/_DashboardContent.cshtml" model="content" />

@section Scripts {
    <script>
        window.nimbusBurndown = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ViewModel.Burndown.Labels)),
            actual: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ViewModel.Burndown.Actual)),
            ideal: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ViewModel.Burndown.Ideal))
        };
    </script>
    <script src="~/js/burndown-chart.js" asp-append-version="true"></script>
}
