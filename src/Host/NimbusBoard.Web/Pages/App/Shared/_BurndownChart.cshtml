@model NimbusBoard.Application.Dashboard.BurndownChartViewModel
<div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
    <h2 class="mb-2 text-base font-semibold text-slate-900">Burndown</h2>
    <div class="mb-2 flex items-center gap-4 text-xs text-slate-500">
        <span class="flex items-center gap-2"><span class="h-0.5 w-6 bg-indigo-500"></span> Actual</span>
        <span class="flex items-center gap-2"><span class="h-0.5 w-6 border-t border-dashed border-slate-400"></span> Ideal</span>
    </div>
    @if (Model.Labels.Count == 0)
    {
        <div class="flex h-44 flex-col items-center justify-center rounded-xl bg-slate-50 px-4 text-center">
            <svg class="mb-2 h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18M7 15l4-4 3 3 5-6" />
            </svg>
            <p class="text-sm font-medium text-slate-600">No burndown data yet</p>
            <p class="mt-1 max-w-xs text-xs text-slate-500">Start an active sprint and the actual vs ideal remaining points will chart here.</p>
        </div>
    }
    else
    {
        <div class="relative h-40 w-full">
            <canvas id="burndown-chart"></canvas>
        </div>
    }
</div>
