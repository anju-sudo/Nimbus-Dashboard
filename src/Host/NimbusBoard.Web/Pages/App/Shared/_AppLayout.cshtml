@{
    var title = ViewData["Title"] as string ?? "Nimbus Board";
    var activeNav = ViewData["ActiveNav"] as string ?? "dashboard";
    var unread = ViewData["UnreadNotifications"] as int? ?? 0;
    var userName = ViewData["UserName"] as string ?? "Anjumol Babu";
    var userInitials = ViewData["UserInitials"] as string ?? "AB";
    var workspace = ViewData["WorkspaceName"] as string ?? "Acme";
    var memberId = ViewData["MemberId"] as int? ?? 1;
    var brandName = ViewData["BrandName"] as string ?? "Nimbus";

    string NavClass(string key) => activeNav == key
        ? "bg-indigo-50 text-indigo-700"
        : "text-slate-600 hover:bg-slate-50 hover:text-slate-900";

    string IconClass(string key) => activeNav == key ? "text-indigo-600" : "text-slate-400";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Nimbus Board</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <style>
        body { font-family: 'Inter', system-ui, sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900" data-member-id="@memberId">
@Html.AntiForgeryToken()

<div id="sidebar-overlay" class="fixed inset-0 z-40 hidden bg-slate-900/40 lg:hidden" onclick="window.nimbusCloseSidebar()"></div>

<div class="flex min-h-screen">
    <aside id="app-sidebar"
           class="fixed inset-y-0 left-0 z-50 flex w-[260px] -translate-x-full flex-col border-r border-slate-200/80 bg-white transition-transform duration-200 lg:static lg:translate-x-0">
        @* Brand *@
        <div class="px-5 pb-4 pt-5">
            <div class="flex items-center justify-between gap-3">
                <a href="/" class="flex min-w-0 items-center gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white shadow-sm shadow-indigo-200">@(string.IsNullOrEmpty(brandName) ? "N" : brandName[0])</div>
                    <div class="min-w-0">
                        <p class="truncate text-[15px] font-semibold tracking-tight text-slate-900">@brandName</p>
                        <p class="truncate text-xs text-slate-500">@workspace workspace</p>
                    </div>
                </a>
                <button type="button" class="rounded-lg p-2 text-slate-400 hover:bg-slate-50 lg:hidden" onclick="window.nimbusCloseSidebar()" aria-label="Close menu">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>

        <nav class="flex flex-1 flex-col gap-6 overflow-y-auto px-3 pb-4">
            @* Primary *@
            <div class="space-y-0.5">
                <a href="/" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium @NavClass("dashboard")">
                    <svg class="h-[18px] w-[18px] shrink-0 @IconClass("dashboard")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 14a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1v-5zm10 3a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1v-2z"/></svg>
                    Dashboard
                </a>
                <a href="/app/my-work" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium @NavClass("my-work")">
                    <svg class="h-[18px] w-[18px] shrink-0 @IconClass("my-work")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    My work
                </a>
            </div>

            @* Workspace *@
            <div>
                <p class="mb-1.5 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Workspace</p>
                <div class="space-y-0.5">
                    <a href="/app/projects" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium @NavClass("projects")">
                        <svg class="h-[18px] w-[18px] shrink-0 @IconClass("projects")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>
                        Projects
                    </a>
                    <a href="/app/boards" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium @NavClass("boards")">
                        <svg class="h-[18px] w-[18px] shrink-0 @IconClass("boards")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4h1.5v16H9V4zm4.5 0H15v16h-1.5V4zM4.5 4H6v16H4.5V4zm15 0H21v16h-1.5V4z"/></svg>
                        Boards
                    </a>
                    <a href="/app/sprints" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium @NavClass("sprints")">
                        <svg class="h-[18px] w-[18px] shrink-0 @IconClass("sprints")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        Sprints
                    </a>
                </div>
            </div>

            @* You *@
            <div>
                <p class="mb-1.5 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">You</p>
                <div class="space-y-0.5">
                    <a href="/app/notifications" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium @NavClass("notifications")">
                        <svg class="h-[18px] w-[18px] shrink-0 @IconClass("notifications")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 10-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0a3 3 0 11-6 0"/></svg>
                        <span class="flex-1">Notifications</span>
                        <span id="notification-badge"
                              class="@(unread > 0 ? "" : "hidden") inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-rose-500 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-white"
                              data-count="@unread">@(unread > 0 ? unread.ToString() : "")</span>
                    </a>
                    <a href="/app/settings" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium @NavClass("settings")">
                        <svg class="h-[18px] w-[18px] shrink-0 @IconClass("settings")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        Settings
                    </a>
                </div>
            </div>
        </nav>

        @* User footer *@
        <div class="mt-auto border-t border-slate-100 p-3">
            <div class="flex items-center gap-3 rounded-xl px-2 py-2.5">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-xs font-semibold text-indigo-700">@userInitials</div>
                <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-slate-900">@userName</p>
                    <p class="text-xs text-slate-500">Member</p>
                </div>
            </div>
        </div>
    </aside>

    <main class="flex-1 overflow-auto">
        <div class="sticky top-0 z-30 flex items-center gap-3 border-b border-slate-200 bg-slate-50/95 px-4 py-3 backdrop-blur lg:hidden">
            <button type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700" onclick="window.nimbusOpenSidebar()">Menu</button>
            <button type="button" onclick="window.nimbusOpenSearch()"
                    class="flex flex-1 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-400">
                <span>Search...</span>
                <span class="ml-auto rounded border border-slate-200 px-1.5 text-xs">⌘K</span>
            </button>
        </div>
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
            @RenderBody()
        </div>
    </main>
</div>

<div id="search-modal" class="fixed inset-0 z-50 hidden items-start justify-center bg-slate-900/40 p-4 sm:p-8">
    <div class="w-full max-w-xl rounded-2xl bg-white p-4 shadow-xl">
        <input id="global-search-input"
               type="text"
               name="q"
               placeholder="Search issues, projects, boards..."
               hx-get="/app/search"
               hx-trigger="keyup changed delay:200ms"
               hx-target="#search-results"
               hx-swap="innerHTML"
               class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-indigo-500" />
        <div id="search-results" class="mt-3 max-h-80 overflow-y-auto">
            <p class="px-2 py-4 text-sm text-slate-500">Type to search issues, projects, and boards.</p>
        </div>
        <button type="button" onclick="window.nimbusCloseSearch()" class="mt-3 text-sm text-slate-500">Close (Esc)</button>
    </div>
</div>

<div id="toast-root" class="pointer-events-none fixed bottom-4 right-4 z-50 flex w-80 flex-col gap-2"></div>

@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/search-shortcut.js" asp-append-version="true"></script>
<script src="~/js/notifications-hub.js" asp-append-version="true"></script>
</body>
</html>
