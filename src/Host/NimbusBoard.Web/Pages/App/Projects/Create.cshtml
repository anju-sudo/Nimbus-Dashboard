@page "/app/projects/new"
@model Nimbus_Board.Pages.App.Projects.CreateModel

<div class="mx-auto max-w-2xl">
    <a href="/app/projects" class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-700">
        <span aria-hidden="true">←</span> Back to projects
    </a>

    <div class="mt-4 mb-8">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Create project</h1>
        <p class="mt-1 text-sm text-slate-500">A project groups issues, boards, and sprints under one key.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm" id="create-project-form">
        <div class="space-y-6 p-6 sm:p-8">
            <div>
                <label asp-for="Input.Name" class="mb-1.5 block text-sm font-medium text-slate-800">Name</label>
                <input asp-for="Input.Name" id="project-name"
                       class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none ring-indigo-500/30 focus:border-indigo-400 focus:ring-4"
                       placeholder="Nimbus Platform" required />
            </div>

            <div>
                <label asp-for="Input.Key" class="mb-1.5 block text-sm font-medium text-slate-800">Project key</label>
                <input asp-for="Input.Key" id="project-key"
                       class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 font-mono text-sm uppercase tracking-wide outline-none ring-indigo-500/30 focus:border-indigo-400 focus:ring-4"
                       placeholder="NIM" maxlength="10" required />
                <p class="mt-2 text-xs leading-relaxed text-slate-500">
                    Short unique code used as the prefix for issue IDs — like Jira.
                    Example: key <span class="font-semibold text-slate-700">NIM</span> creates issues
                    <span class="font-mono text-slate-700">NIM-1</span>, <span class="font-mono text-slate-700">NIM-2</span>, …
                    Use 2–10 letters or numbers. It can’t be changed later easily.
                </p>
                <p class="mt-2 text-xs text-slate-400">
                    Preview: <span id="key-preview" class="font-mono font-medium text-indigo-600">NIM-1</span>
                </p>
            </div>

            <div>
                <label asp-for="Input.Description" class="mb-1.5 block text-sm font-medium text-slate-800">Description <span class="font-normal text-slate-400">(optional)</span></label>
                <textarea asp-for="Input.Description" rows="4"
                          class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none ring-indigo-500/30 focus:border-indigo-400 focus:ring-4"
                          placeholder="What is this project for?"></textarea>
            </div>
        </div>

        <div class="flex items-center justify-between gap-3 border-t border-slate-100 bg-slate-50/80 px-6 py-4 sm:px-8">
            <p class="hidden text-xs text-slate-500 sm:block">A default board with To Do / In Progress / Done is created automatically.</p>
            <div class="flex w-full gap-2 sm:w-auto">
                <a href="/app/projects" class="flex-1 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-slate-700 hover:bg-slate-50 sm:flex-none">Cancel</a>
                <button type="submit" class="flex-1 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700 sm:flex-none">Create project</button>
            </div>
        </div>
    </form>
</div>

<script>
(() => {
    const nameInput = document.getElementById('project-name');
    const keyInput = document.getElementById('project-key');
    const preview = document.getElementById('key-preview');
    let keyTouched = false;

    function suggestKey(name) {
        const words = (name || '').toUpperCase().replace(/[^A-Z0-9\s]/g, ' ').trim().split(/\s+/).filter(Boolean);
        if (!words.length) return '';
        if (words.length === 1) return words[0].slice(0, 4);
        return words.map(w => w[0]).join('').slice(0, 4);
    }

    function updatePreview() {
        const key = (keyInput.value || 'KEY').toUpperCase() || 'KEY';
        preview.textContent = key + '-1';
    }

    keyInput.addEventListener('input', () => {
        keyTouched = true;
        keyInput.value = keyInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 10);
        updatePreview();
    });

    nameInput.addEventListener('input', () => {
        if (!keyTouched || !keyInput.value) {
            keyInput.value = suggestKey(nameInput.value);
        }
        updatePreview();
    });

    updatePreview();
})();
</script>
