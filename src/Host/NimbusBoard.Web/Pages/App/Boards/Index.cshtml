@page "/app/boards"
@model Nimbus_Board.Pages.App.Boards.IndexModel

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Boards</h1>
        <p class="mt-1 max-w-xl text-sm text-slate-500">
            Kanban workflows for your projects — columns are stages, cards are issues you drag between them.
            @Model.Boards.Count board@(Model.Boards.Count == 1 ? "" : "s") in this workspace.
        </p>
    </div>
    <a href="/app/projects"
       class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
        View projects
    </a>
</div>

@if (!Model.Boards.Any())
{
    <div class="rounded-2xl border border-dashed border-slate-200 bg-white px-6 py-16 text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5h6M9 19.5h6M4.5 9v6M19.5 9v6M6.75 4.5h10.5A2.25 2.25 0 0 1 19.5 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 17.25V6.75A2.25 2.25 0 0 1 6.75 4.5Z" />
            </svg>
        </div>
        <h2 class="text-lg font-semibold text-slate-900">No boards yet</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">
            Boards are created with each project. Create a project to get a Kanban board with To Do / In Progress / Done.
        </p>
        <a href="/app/projects/new" class="mt-6 inline-flex rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700">Create project</a>
    </div>
}
else
{
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        @foreach (var board in Model.Boards)
        {
            var total = board.OpenIssueCount + board.DoneIssueCount;
            var donePct = total == 0 ? 0 : (int)Math.Round(100.0 * board.DoneIssueCount / total);
            var keyBadge = board.ProjectKey.Length <= 3 ? board.ProjectKey : board.ProjectKey[..3];

            <div class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md">
                <div class="absolute inset-x-0 top-0 h-1 @board.AccentClass"></div>
                <a href="/app/boards/@board.Id" class="block p-5 pt-6">
                    <div class="mb-4 flex items-start justify-between gap-3">
                        <div class="flex min-w-0 items-center gap-3">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-sm font-bold text-white @board.AccentClass">
                                @keyBadge
                            </span>
                            <div class="min-w-0">
                                <h2 class="truncate text-base font-semibold text-slate-900 group-hover:text-indigo-700">@board.Name</h2>
                                <p class="truncate text-xs text-slate-500">@board.ProjectKey · @board.ProjectName</p>
                            </div>
                        </div>
                        <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                            @board.ColumnCount col@(board.ColumnCount == 1 ? "" : "s")
                        </span>
                    </div>

                    <div class="mb-3">
                        <div class="mb-1.5 flex items-center justify-between text-xs text-slate-500">
                            <span>Flow</span>
                            <span class="font-medium text-slate-700">@donePct% done</span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-slate-100">
                            <div class="h-full rounded-full @board.AccentClass" style="width: @(donePct)%"></div>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-600">
                        <span class="rounded-lg bg-slate-50 px-2.5 py-1 ring-1 ring-slate-100">@board.OpenIssueCount open</span>
                        <span class="rounded-lg bg-slate-50 px-2.5 py-1 ring-1 ring-slate-100">@board.DoneIssueCount done</span>
                        <span class="rounded-lg bg-slate-50 px-2.5 py-1 ring-1 ring-slate-100">@board.IssueCount total</span>
                    </div>
                </a>

                <div class="flex items-center justify-end border-t border-slate-100 px-4 py-2.5">
                    <form method="post"
                          asp-page-handler="Delete"
                          class="m-0"
                          onsubmit="return confirm('Delete this board? Issues stay in the project and are only removed from the Kanban columns.');">
                        <input type="hidden" name="boardId" value="@board.Id" />
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium text-rose-600 hover:bg-rose-50"
                                title="Delete board">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
