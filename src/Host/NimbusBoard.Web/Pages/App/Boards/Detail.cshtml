@page "/app/boards/{id:guid}"
@model Nimbus_Board.Pages.App.Boards.DetailModel
@{
    var board = Model.Board;
    if (board is null)
    {
        return;
    }

    var defaultColumnId = board.Columns.FirstOrDefault()?.Id;
    var createIssueUrl = defaultColumnId is Guid colId
        ? $"/app/issues/create?projectId={board.ProjectId}&boardColumnId={colId}"
        : $"/app/issues/create?projectId={board.ProjectId}";
}

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
        <a href="/app/boards" class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-700">
            <span aria-hidden="true">←</span> Boards
        </a>
        <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="rounded-lg bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">@board.ProjectKey</span>
            <span class="text-xs text-slate-400">@board.ProjectName</span>
        </div>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@board.Name</h1>
        <p class="mt-1 text-sm text-slate-500">Drag cards between columns to update status.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <form method="post"
              asp-page-handler="Delete"
              class="m-0"
              onsubmit="return confirm('Delete this board? Issues stay in the project and are only removed from the Kanban columns.');">
            <button type="submit"
                    class="rounded-xl border border-rose-200 bg-white px-4 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">
                Delete board
            </button>
        </form>
        <button type="button"
                hx-get="@createIssueUrl"
                hx-target="#modal-root"
                hx-swap="innerHTML"
                class="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700">+ New Issue</button>
    </div>
</div>

<div class="flex gap-4 overflow-x-auto pb-4" id="kanban-board" data-board-id="@board.Id">
    @foreach (var column in board.Columns)
    {
        <div class="w-80 shrink-0 rounded-2xl bg-slate-100 p-3" data-column-id="@column.Id">
            <div class="mb-3 flex items-center justify-between px-1">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">@column.Name</h2>
                <span class="rounded-full bg-white px-2 py-0.5 text-xs text-slate-500">@column.Issues.Count</span>
            </div>
            <div class="kanban-column min-h-[200px] space-y-2" data-column-id="@column.Id">
                @foreach (var issue in column.Issues)
                {
                    <partial name="Shared/_BoardIssueCard" model="issue" />
                }
            </div>
        </div>
    }
</div>

<div id="modal-root"></div>
<div id="issue-panel-root"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="~/js/sortable-init.js" asp-append-version="true"></script>
}
